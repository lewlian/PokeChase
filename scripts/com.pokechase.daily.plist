<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pokechase.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/sean/Desktop/pokechase &amp;&amp; mkdir -p data/logs &amp;&amp; npx tsx scripts/ingest-daily.ts >> data/logs/daily.log 2>&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <!-- 14:05 local — after TCGCSV's ~20:00 UTC refresh -->
    <key>Hour</key>
    <integer>14</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/sean/Desktop/pokechase/data/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sean/Desktop/pokechase/data/logs/launchd.log</string>
</dict>
</plist>
